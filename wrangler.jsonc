{
  "name": "zippytitle",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  // Not secret. RESEND_API_KEY is a secret and is set in the dashboard.
  "vars": {
    "CONTACT_TO": "leads@getmarketingbull.com",
    "CONTACT_FROM": "ZippyTitle <noreply@zippytitle.com>"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls invoke the Worker; static files are served directly.
    "run_worker_first": ["/api/*"]
  }
}
